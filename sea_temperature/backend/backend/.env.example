# Supabase: copy the Session pooler URI from Dashboard > Connect.
# URL-encode special characters in the database password (not an API key).
# Nonempty DATABASE_URL overrides DB_HOST/PORT/NAME/USER/PASSWORD/SSLMODE.
# SSL defaults to require for DATABASE_URL; URL sslmode takes precedence.
DATABASE_URL=
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
DB_STATEMENT_TIMEOUT_MS=15000

# Local PostgreSQL fallback when DATABASE_URL is empty.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nifs_ocean
DB_USER=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
DB_CONNECT_TIMEOUT=5

# Customer session settings. HTTPS deployments must set SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=false
GUEST_SESSION_DAYS=30
MEMBER_SESSION_DAYS=7
# JSON array; specify browser frontend origins, never a wildcard with credentials.
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]
